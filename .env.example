# ─────────────────────────────────────────────
# TELEGRAM
# ─────────────────────────────────────────────
# Token do bot gerado pelo @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ID numérico ou @username do canal de destino (ex: -1001234567890 ou @meucanal)
TELEGRAM_CHANNEL_ID=@your_channel_here

# ─────────────────────────────────────────────
# AFILIADOS
# ─────────────────────────────────────────────
# Seu ID de afiliado (Amazon, Magalu, etc.)
AFFILIATE_ID=MEU_ID_AFILIADO

# Tag de rastreio Amazon (ex: meutag-20)
AMAZON_ASSOCIATE_TAG=meutag-20

# ─────────────────────────────────────────────
# SCRAPER
# ─────────────────────────────────────────────
# Intervalo de verificação em minutos
SCRAPE_INTERVAL_MINUTES=5

# Desconto mínimo para postar (%)
MIN_DISCOUNT_PERCENT=15

# Número máximo de ofertas por ciclo
MAX_DEALS_PER_RUN=5

# ─────────────────────────────────────────────
# BANCO DE DADOS
# ─────────────────────────────────────────────
# Caminho do arquivo SQLite (relativo à raiz do projeto)
DATABASE_PATH=data/deals.db

# Quantos dias manter registros de deals vistos
DEDUP_TTL_DAYS=7

# ─────────────────────────────────────────────
# LOGS
# ─────────────────────────────────────────────
# Nível: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Caminho do arquivo de log
LOG_FILE=logs/bot.log
