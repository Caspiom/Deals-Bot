# ─────────────────────────────────────────────
# PUBLISHERS ATIVOS (csv: telegram, x, instagram)
# ─────────────────────────────────────────────
ENABLED_PUBLISHERS=telegram

# ─────────────────────────────────────────────
# TELEGRAM
# ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHANNEL_ID=@your_channel_here

# ─────────────────────────────────────────────
# X (TWITTER)
# Obter em: https://developer.twitter.com/en/portal/dashboard
# ─────────────────────────────────────────────
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# ─────────────────────────────────────────────
# INSTAGRAM
# Requer: conta Business/Creator + Facebook Page vinculada
# Access Token: https://developers.facebook.com/tools/explorer/
# Permissões necessárias: instagram_content_publish, instagram_basic
# ─────────────────────────────────────────────
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# ─────────────────────────────────────────────
# DISCORD
# Criar bot: discord.com/developers/applications → New Application → Bot
# Adicionar ao servidor via OAuth2 → URL Generator (scopes: bot)
# Permissões: Send Messages, Embed Links, Attach Files, View Channels
# O bot posta em qualquer canal chamado DISCORD_CHANNEL_NAME em todos os servidores
# ─────────────────────────────────────────────
DISCORD_BOT_TOKEN=

# ─────────────────────────────────────────────
# AFILIADOS
# ─────────────────────────────────────────────
AFFILIATE_ID=MEU_ID_AFILIADO
# Amazon Associates: associados.amazon.com.br → Associate tag para injeção de afiliado
# AmazonScraper raspa HTML da página /deals — não requer PA API nem chaves AWS
AMAZON_ASSOCIATE_TAG=achadin09c587-20
# AliExpress Portals: portals.aliexpress.com
ALIEXPRESS_TRACKING_ID=seu_tracking_id
ALIEXPRESS_APP_KEY=seu_app_key
ALIEXPRESS_SECRET_KEY=seu_secret_key
# Americanas: Awin Brasil → My Advertisers → Americanas → Merchant ID
AMERICANAS_AWIN_MID=

# ─────────────────────────────────────────────
# SCRAPER
# ─────────────────────────────────────────────
SCRAPE_INTERVAL_MINUTES=5
MIN_DISCOUNT_PERCENT=15
MAX_DEALS_PER_RUN=20

# Máximo de navegadores Chromium simultâneos (padrão 2 cabe em 1.5GB de container)
PLAYWRIGHT_MAX_BROWSERS=2

# Proxy residencial/datacenter para evasão de bloqueios anti-bot (opcional)
# Formato: http://usuario:senha@host:porta  |  socks5://host:porta
# Compatível com Playwright e httpx — deixe em branco para conexão direta
PROXY_URL=

# Re-post de promos quentes: deals com desconto >= MIN_HOT_DISCOUNT_PCT
# são re-postados se o último post foi há >= REPOST_INTERVAL_HOURS horas.
MIN_HOT_DISCOUNT_PCT=40
REPOST_INTERVAL_HOURS=2

# ─────────────────────────────────────────────
# CLICK TRACKING
# URL base do servidor de rastreamento (achadinhosbr.com)
# Deixar vazio para desativar — publishers usam affiliate_url direto
# Rodar API: uvicorn src.api.app:app --host 0.0.0.0 --port 8000
# ─────────────────────────────────────────────
TRACKER_BASE_URL=https://achadinhosbr.com/r

# ─────────────────────────────────────────────
# BANCO DE DADOS
# ─────────────────────────────────────────────
DATABASE_PATH=data/deals.db
DEDUP_TTL_DAYS=7

# ─────────────────────────────────────────────
# LOGS
# ─────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
